<clickhouse>
    <!-- Overrides for PostHog's ClickHouse image, loaded after config.xml (config.d). -->
    <logger>
        <level>information</level>
        <console>1</console>
        <log>/var/lib/posthog/clickhouse/logs/server.log</log>
        <errorlog>/var/lib/posthog/clickhouse/logs/error.log</errorlog>
        <size>50M</size>
        <count>3</count>
    </logger>

    <!-- Only this container talks to it. -->
    <listen_host>127.0.0.1</listen_host>

    <path>/var/lib/posthog/clickhouse/data/</path>
    <!-- PostHog's executable UDFs (JSONCleanPostHogEvent and friends) live in the app image; their
         definitions are user_defined_function.xml, loaded from /etc/clickhouse-server by the
         default user_defined_executable_functions_config glob. A migration's materialized view
         calls one of them, so without these ClickHouse migrations fail with
         "Code: 46. Function with name JSONCleanPostHogEvent does not exist". -->
    <user_scripts_path>/app/code/user_scripts/</user_scripts_path>
    <tmp_path>/var/lib/posthog/clickhouse/tmp/</tmp_path>
    <user_files_path>/var/lib/posthog/clickhouse/user_files/</user_files_path>
    <format_schema_path>/var/lib/posthog/clickhouse/format_schemas/</format_schema_path>
    <access_control_path>/var/lib/posthog/clickhouse/access/</access_control_path>
    <user_directories>
        <users_xml>
            <path>/etc/clickhouse-server/users.xml</path>
        </users_xml>
        <local_directory>
            <path>/var/lib/posthog/clickhouse/access/</path>
        </local_directory>
    </user_directories>

    <!-- Sized for a 12 GiB app on any host, not for the host it happens to run on. ClickHouse sizes
         its thread pools and caches from the machine's core count and RAM (96 cores on the test
         host): that gave 839 threads and a 7.4 GiB RSS with almost no data, which then failed its own
         queries with MEMORY_LIMIT_EXCEEDED. These are the numbers the live standalone stack gets from
         its 4 GiB cgroup. -->
    <max_server_memory_usage>4294967296</max_server_memory_usage>
    <max_server_memory_usage_to_ram_ratio>1.0</max_server_memory_usage_to_ram_ratio>
    <max_thread_pool_size>64</max_thread_pool_size>
    <max_io_thread_pool_size>16</max_io_thread_pool_size>
    <max_concurrent_queries>16</max_concurrent_queries>
    <background_pool_size>4</background_pool_size>
    <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>
    <background_move_pool_size>2</background_move_pool_size>
    <background_fetches_pool_size>2</background_fetches_pool_size>
    <background_common_pool_size>4</background_common_pool_size>
    <background_buffer_flush_schedule_pool_size>2</background_buffer_flush_schedule_pool_size>
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <background_message_broker_schedule_pool_size>4</background_message_broker_schedule_pool_size>
    <background_distributed_schedule_pool_size>2</background_distributed_schedule_pool_size>
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <index_mark_cache_size>33554432</index_mark_cache_size>
    <index_uncompressed_cache_size>0</index_uncompressed_cache_size>
    <mmap_cache_size>512</mmap_cache_size>
    <primary_index_cache_size>67108864</primary_index_cache_size>
    <query_condition_cache_size>33554432</query_condition_cache_size>
    <compiled_expression_cache_size>33554432</compiled_expression_cache_size>
    <compiled_expression_cache_elements_size>1000</compiled_expression_cache_elements_size>
    <total_memory_profiler_step>0</total_memory_profiler_step>

    <!-- Cluster definitions live in clusters.xml (upstream's docker/clickhouse/config.d/default.xml,
         one node). -->

    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>

    <!-- ClickHouse's built-in Keeper replaces ZooKeeper (the hobby stack's zookeeper container). -->
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/posthog/clickhouse/keeper/log</log_storage_path>
        <snapshot_storage_path>/var/lib/posthog/clickhouse/keeper/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>127.0.0.1</hostname>
                <port>9444</port>
            </server>
        </raft_configuration>
    </keeper_server>

    <zookeeper>
        <node>
            <host>127.0.0.1</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <!-- Nightly Cloudron backup target: BACKUP DATABASE ... TO Disk('backups', ...) lands in
         /app/data, which Cloudron copies. The live data directory is outside /app/data because
         ClickHouse's temporary merge directories make Cloudron's rsync backup abort
         (see README "Backups"). -->
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/app/data/clickhouse-backup/</path>
            </backups>
        </disks>
    </storage_configuration>
</clickhouse>
