<clickhouse>
    <!-- The observability tables ClickHouse writes for itself (query_log, part_log, metric_log,
         trace_log, asynchronous_metric_log, query_thread_log) cost a large share of the server's
         RSS and are of no use in this package: nobody reads them, and the container has a 12 GiB
         budget for the whole stack. Removing the sections keeps the /query_log surfaces off; the
         crash log (system.crash_log) stays, because PostHog's migrations create a view over it. -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <trace_log remove="1"/>
    <part_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
</clickhouse>
