# Secrets and durable settings for this PostHog instance. Generated on first boot; never committed.
#
# Everything here is read at start-up and handed to the services. Editing these values after the
# first boot breaks the instance (POSTHOG_SECRET signs sessions, ENCRYPTION_SALT_KEYS decrypts
# stored integration credentials), so treat this file as data, not configuration.
#
# Settings you may want to change are at the bottom; uncomment and restart the app.

export POSTHOG_SECRET=##POSTHOG_SECRET##
export ENCRYPTION_SALT_KEYS=##ENCRYPTION_SALT_KEYS##
export INTERNAL_API_SECRET=##INTERNAL_API_SECRET##

# ClickHouse users PostHog creates for itself on first migration (see posthog/clickhouse/cluster.py).
export CLICKHOUSE_APP_PASSWORD=##CLICKHOUSE_APP_PASSWORD##
export CLICKHOUSE_API_PASSWORD=##CLICKHOUSE_API_PASSWORD##
export CLICKHOUSE_BILLING_PASSWORD=##CLICKHOUSE_BILLING_PASSWORD##
export CLICKHOUSE_DICT_READER_PASSWORD=##CLICKHOUSE_DICT_READER_PASSWORD##

# --- Optional tuning -------------------------------------------------------------------------
# Extra Caddy-free settings for PostHog itself can go here; they are exported to every service.
# export EMAIL_ENABLED=false
